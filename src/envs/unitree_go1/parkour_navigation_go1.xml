    <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

       <!-- Left wall -->
        <geom name="left_wall" type="box" pos="-10 0 1" size="0.05 10 1" rgba="0.5 0.5 0.5 1"/>

        <!-- Right wall -->
        <geom name="right_wall" type="box" pos="10 0 1" size="0.05 10 1" rgba="0.5 0.5 0.5 1"/>

        <!-- Front wall -->
        <geom name="front_wall" type="box" pos="0 10 1" size="10 0.05 1" rgba="0.5 0.5 0.5 1"/>

        <!-- Back wall -->
        <geom name="back_wall" type="box" pos="0 -10 1" size="10 0.05 1" rgba="0.5 0.5 0.5 1"/>

    <body name="obstacle">
      <joint name="rooty" axis="0 1 0" type="slide" limited="false" armature="0" damping="0"/>
      <geom  name="m_obstacle" type="box"  size="0.4 0.4 0.5" pos="3 0 0.55" conaffinity="1"  rgba=".7 .5 .3 1" />
    </body>
    <!--    <geom  name="obstacle1" type="box"  size="0.6 2 0.5" pos="3 -1 0.55" conaffinity="1"  rgba=".0 .5 .3 1" euler="0 0 1.57" />-->
<!--    <geom  name="obstacle2" type="box"  size="0.2 2 0.5" pos="6 2 0.55" conaffinity="1"  rgba=".0 .5 .3 1" euler="0 0 1.57" />-->
