<!--    <geom  name="m_obstacle3" type="box"  size="0.4 0.4 0.5" pos="0 4 0.55" conaffinity="1"  rgba=".7 .5 .3 1" />-->


    <geom name="target" type="sphere" pos="8 0 0.5" size=".1" rgba=".6 .3 .3 1" conaffinity="0"/>
<!--    <geom name="floor" size="30 30 0.05" type="plane" material="groundplane"/>-->
<!--    <geom name="bubble" type="sphere" pos="0 0 0.325" size=".4" rgba=".6 .3 .3 0.1" conaffinity="0"/>-->

  </worldbody>

    <actuator>

    <motor name="move" joint="rooty" gear="200"/>
  </actuator>

    <keyframe>
    <key name="home" qpos="0 0 0.325 1 0 0 0 -0.1 -0.8 1.5 0.1 0.8 -1.5 0.1 -1.0 1.5 -0.1 1.0 -1.5 0"/>
  </keyframe>
</mujoco>
