<mujoco model="go1 navigation obstacles">
<!---->
  <include file="go1_robot.xml"/>

  <option cone='elliptic' noslip_iterations='5' noslip_tolerance='0'/>

  <visual>
    <map znear='0.001'/>
    <headlight diffuse='.6 .6 .6'  ambient='.3 .3 .3' specular='0 0 0'/>
    <scale forcewidth='0.01' contactwidth='0.06' contactheight='0.01' jointwidth='.01' framewidth='.01' framelength='.3'/>
    <global offheight="2160" offwidth="3840"/>
  </visual>


    <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

       <!-- Left wall -->
        <geom name="left_wall" type="box" pos="-5 0 1" size="0.1 3 1" rgba="0.5 0.5 0.5 1" conaffinity="1"/>

        <!-- Right wall -->
        <geom name="right_wall" type="box" pos="5 0 1" size="0.1 3 1" rgba="0.5 0.5 0.5 1" conaffinity="1"/>

        <!-- Front wall -->
        <geom name="front_wall" type="box" pos="0 3 1" size="5 0.1 1" rgba="0.5 0.5 0.5 1" conaffinity="1"/>

        <!-- Back wall -->
        <geom name="back_wall" type="box" pos="0 -3 1" size="5 0.1 1" rgba="0.5 0.5 0.5 1" conaffinity="1"/>

<!--        <geom  name="obstacle_1" type="box"  pos="0 0 0.5" size="1 2 0.5" rgba=".7 .5 .3 1" conaffinity="1" />-->
       <body name="obstacle_1" pos="0 0 0.55" >
           <joint name="obstacle_1" axis="0 1 0" type="slide" limited="false" armature="0" damping="0"/>
              <geom  name="obstacle_1" type="box"   size="0.5 0.5 0.5" rgba=".7 .5 .3 1" conaffinity="1" />
           <site name="obstacle_1" type="sphere" size=".1" rgba=".6 .3 .3 1"  />
<!--           <freejoint name="obstacle_1" />-->
       </body>



    <geom name="target" type="sphere" pos="4 0 0.5" size=".1" rgba=".6 .3 .3 1"  />

  </worldbody>

    <actuator>
       <velocity name="obstacle_1" joint="obstacle_1" kv="500" ctrlrange="-1 1" forcerange="-500 500" />
    </actuator>

</mujoco>
