<mujoco model="go1 walk">

  <include file="go1_robot_50_rays.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offheight="2160" offwidth="3840"/>

  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
      <site name="reference" pos="0 0 0"/>
      <camera name="frontview" pos="0 0 10" fovy="90" euler="0 0 -1.57"/>
      <camera name="backview" pos="-6 0 3" fovy="90" euler="0 -0.7853981633974483 -1.57"/>

    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 0" condim="3" friction="0.8" size="100 100 0.125" type="plane" material="groundplane" contype="1" conaffinity="0" />
        <geom  name="wall_3" type="box"  pos="0 5 0.5" size="100 0.01 1.5" rgba=".0 .4 .4 1" conaffinity="1" />
          <geom  name="wall_4" type="box"  pos="0 -5 0.5" size="100 0.01 1.5" rgba=".0 .4 .4 1" conaffinity="1" />

    <body name="obstacle_1" pos="4 0 0.8" >
        <freejoint name="obstacle"/>
      <geom  name="obstacle_1" type="box" mass="60" size="0.5 0.5 0.8" rgba=".1 .4 .4 1" conaffinity="1" priority="1" friction="0.01" condim="1"/>
      <site name="obstacle_1" type="cylinder" size=".1 0.8" rgba=".6 .3 .3 0.1"  />

       </body>
          <site name="target" type="box" pos="7 0 0" size="0.25 5 0.1" rgba=".6 .3 .3 0.2"  />

  </worldbody>


    <actuator>
        <position name="position_x" site="obstacle_1" refsite="reference" gear="1 0 0 0 0 0" kp="200" dampratio="1" />
        <position name="rotation_z" site="obstacle_1" refsite="reference" gear="0 0 0 0 0 1" kp="200" dampratio="1" ctrlrange="-1.571 1.571"/>
        <velocity name="thrust2" site="obstacle_1" gear="0 1 0 0 0 0" ctrlrange="-1 1" kv="50" />
    </actuator>

</mujoco>
