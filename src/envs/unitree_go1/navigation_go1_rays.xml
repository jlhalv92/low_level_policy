<mujoco model="go1 walk">

  <include file="go1_robot_object_dect.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
          <geom  name="wall_1" type="box"  pos="10 0 0.5"  size="0.1 5 1.5" rgba=".0 .4 .4 1" conaffinity="1" />
          <geom  name="wall_2" type="box" pos="-10 0 0.5"  size="0.1 5 1.5" rgba=".0 .4 .4 1" conaffinity="1" />
          <geom  name="wall_3" type="box"  pos="0 5 0.5" size="10 0.1 1.5" rgba=".0 .4 .4 1" conaffinity="1" />
          <geom  name="wall_4" type="box"  pos="0 -5 0.5" size="10 0.1 1.5" rgba=".0 .4 .4 1" conaffinity="1" />

    <body name="obstacle_1" pos="2.5 0 0.5" >
        <freejoint name="obstacle"/>
      <geom  name="obstacle_1" type="box" mass="60" size="0.5 0.5 0.8" rgba=".1 .4 .4 1" conaffinity="1" priority="1" friction="0.01" />
      <site name="obstacle_1" type="sphere" size=".1" rgba=".6 .3 .3 1"  />

       </body>
          <site name="target" type="sphere" pos="7 0 0.5" size=".1" rgba=".6 .3 .3 1"  />

  </worldbody>

    <actuator>
            <velocity name="thrust1" site="obstacle_1" gear="1 0 0 0 0 0" ctrlrange="-2 2" kv="100" />
        <velocity name="thrust2" site="obstacle_1" gear="0 1 0 0 0 0" ctrlrange="-2 2" kv="100" />
    </actuator>

</mujoco>
