<geom  name="box9" type="box"  size="0.2 2. 0.4" pos="43.90000000000001 0 0.4" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
<geom  name="box10" type="box"  size="0.2 2. 0.5" pos="48.100000000000016 0 0.5" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
<geom  name="box11" type="box"  size="0.2 2. 0.7" pos="52.30000000000002 0 0.7" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
