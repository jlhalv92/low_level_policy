<mujoco model="planar walker">
  <include file="./common/visual.xml"/>
  <include file="./common/skybox.xml"/>
  <include file="./common/materials.xml"/>

  <option timestep="0.0025"/>

  <statistic extent="2" center="0 0 1"/>

  <default>
    <joint damping=".1" armature="0.01" limited="true" solimplimit="0 .99 .01"/>
    <geom contype="1" conaffinity="0" friction=".7 .1 .1"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
    <site size="0.01"/>
    <default class="walker">
      <geom material="self" type="capsule"/>
      <joint axis="0 -1 0"/>
    </default>
    <default class="object">
      <geom material="self" rgba=".0 .5 .3 1" conaffinity="1" friction=".7 .1 .1"/>
    </default>



  </default>






  <worldbody>
    <geom name="floor" type="plane" conaffinity="1" pos="0 0 0" size=" 100 5 .2" material="grid" zaxis="0 0 1"/>

      <geom  name="box0" type="box"  size="3 2. 0.1" pos="0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />


    <geom  name="box1" type="box"  size="1.0 2. 0.1" pos="9.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
    <geom name="target1" type="sphere" pos="9.0 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light1" diffuse="1 1 1" pos="9.0 0 4"/>

    <geom  name="box2" type="box"  size="1.0 2. 0.1" pos="11.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target2" type="sphere" pos="11. 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light2" diffuse="1 1 1" pos="11. 0 4"/>

    <geom  name="box3" type="box"  size="1.0 2. 0.1" pos="13.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target3" type="sphere" pos="13 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light3" diffuse="1 1 1" pos="13 0 4.4"/>

    <geom  name="box4" type="box"  size="1.0 2. 0.1" pos="15.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target4" type="sphere" pos="15 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light4" diffuse="1 1 1" pos="15 0 4.4"/>

    <geom  name="box5" type="box"  size="1.0 2. 0.1" pos="17.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target5" type="sphere" pos="17 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light5" diffuse="1 1 1" pos="17 0 4.4"/>

    <geom  name="box6" type="box"  size="1.0 2. 0.1" pos="19.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target6" type="sphere" pos="19 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light6" diffuse="1 1 1" pos="19 0 4.4"/>

    <geom  name="box7" type="box"  size="1.0 2. 0.1" pos="21.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target7" type="sphere" pos="21 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light7" diffuse="1 1 1" pos="21 0 4.4"/>

