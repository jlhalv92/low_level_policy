        <geom name="target8" type="sphere" pos="23 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light8" diffuse="1 1 1" pos="23 0 4.4"/>

    <geom  name="box9" type="box"  size="1.0 2. 0.1" pos="25.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target9" type="sphere" pos="25 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light9" diffuse="1 1 1" pos="25 0 4.4"/>

    <geom  name="box10" type="box"  size="1.0 2. 0.1" pos="27.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target10" type="sphere" pos="27 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light10" diffuse="1 1 1" pos="27 0 4.4"/>

    <geom  name="box11" type="box"  size="1.0 2. 0.1" pos="29.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target11" type="sphere" pos="29 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light11" diffuse="1 1 1" pos="29 0 4.4"/>

    <geom  name="box12" type="box"  size="1.0 2. 0.1" pos="31.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
