        <geom name="target15" type="sphere" pos="37 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light15" diffuse="1 1 1" pos="37 0 4.4"/>


    <geom  name="box16" type="box"  size="1.0 2. 0.1" pos="39.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
       <geom name="target16" type="sphere" pos="39 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light16" diffuse="1 1 1" pos="39 0 4.4"/>


    <geom  name="box17" type="box"  size="1.0 2. 0.1" pos="42.0 0 1" conaffinity="1" material="grid"  rgba=".0 .5 .3 1" />
        <geom name="target17" type="sphere" pos="42 0 2.3" size=".1" material="target" conaffinity="0"/>
    <light name="target_light17" diffuse="1 1 1" pos="42 0 4.4"/>

